# ============================================
# 44day_ — конфигурация окружения
# Скопируй этот файл в .env и заполни своими значениями
# ============================================

# --- секрет для подписи сессионных cookie и кодов ---
# Сгенерируй случайную строку 64+ символов, например в PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
AUTH_SECRET=ЗАМЕНИ-НА-ДЛИННУЮ-СЛУЧАЙНУЮ-СТРОКУ

# --- режим работы ---
# production = Secure cookies, нет логов кодов в консоль
NODE_ENV=development

# --- порт сервера ---
PORT=3000

# ============================================
# SMTP (отправка email с кодом подтверждения)
# Если не заполнишь — код пишется в консоль (для разработки)
# ============================================

# Вариант 1: Gmail (нужен App Password — https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=твой_адрес@gmail.com
SMTP_PASS=шестнадцать_букв_от_app_password
SMTP_FROM=44day_ <твой_адрес@gmail.com>

# Вариант 2: Yandex
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=твой@yandex.ru
# SMTP_PASS=пароль_приложения
# SMTP_FROM=44day_ <твой@yandex.ru>

# Вариант 3: Mail.ru
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=твой@mail.ru
# SMTP_PASS=пароль_приложения

# Вариант 4: Mailtrap (для тестов — письма не уходят реально)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=mailtrap_user
# SMTP_PASS=mailtrap_pass
